{
  "name": "claude-companion",
  "version": "0.14.0",
  "private": true,
  "description": "Claude Companion — an unofficial, configurable Chrome extension (MV3). TypeScript sources in src/ are bundled by esbuild into the js/ the extension loads; the optional bridge lives in server/.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "bundle": "node build.mjs",
    "build": "npm run typecheck && node build.mjs",
    "watch": "node build.mjs --watch",
    "pack:firefox": "node scripts/pack-firefox.mjs",
    "lint:ext": "web-ext lint --source-dir dist/firefox --self-hosted",
    "bridge": "node server/server.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "chrono-node": "^2.10.1",
    "dompurify": "^3.4.13",
    "fuse.js": "^7.5.0",
    "turndown": "^7.2.4",
    "webextension-polyfill": "^0.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.0.268",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20.11.0",
    "@types/turndown": "^5.0.6",
    "@types/webextension-polyfill": "^0.12.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10",
    "web-ext": "^10.6.0"
  }
}
