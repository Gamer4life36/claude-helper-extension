{
  "name": "claude-companion",
  "version": "0.14.0",
  "private": true,
  "description": "Claude Companion — an unofficial, configurable Chrome extension (MV3). TypeScript sources in src/ are bundled by esbuild into the js/ the extension loads; the optional bridge lives in server/.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "bundle": "node build.mjs",
    "build": "npm run typecheck && node build.mjs",
    "watch": "node build.mjs --watch",
    "bridge": "node server/server.js"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "chrono-node": "^2.10.1",
    "dompurify": "^3.4.13",
    "fuse.js": "^7.5.0",
    "turndown": "^7.2.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20.11.0",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.0"
  }
}
